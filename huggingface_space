# Use the official Python image
FROM python:3.11-slim

# Set the working directory
WORKDIR /app

# Install system dependencies (required for some Python packages)
RUN apt-get update && apt-get install -y \
    build-essential \
    libglmd-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the requirements file and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt
# Add pillow_avif_plugin to ensure webp/avif support
RUN pip install --no-cache-dir pillow-avif-plugin

# Copy the current directory contents into the container at /app
COPY . .

# Set up permissions for the Hugging Face Spaces specific environment
# Ensure the application can write to the persistent storage or local directory for the memory bank
RUN mkdir -p /app/data && chmod -R 777 /app/data
ENV FAISS_INDEX_PATH="/app/data/memory_bank.index"

# Create a start script to ensure Uvicorn bounds to the port expected by Hugging Face Spaces (7860)
RUN echo '#!/bin/bash\n\
uvicorn main:app --host 0.0.0.0 --port 7860\n\
' > start.sh && chmod +x start.sh

# Expose port (Hugging Face Spaces default Docker port is 7860)
EXPOSE 7860

# Command to run the application
CMD ["./start.sh"]
